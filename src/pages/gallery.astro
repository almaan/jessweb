---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import InstagramEmbed from '../components/InstagramEmbed.astro';
// Featured posts are read at build time from a single plain-text file:
//   src/data/gallery-links.txt  (one Instagram URL per line)
// Just edit that file to add/remove/reorder posts — no code changes needed.
import raw from '../data/gallery-links.txt?raw';

const posts = raw
  .split('\n')
  .map((line) => line.trim())
  .filter((line) => line && !line.startsWith('#'));
---

<BaseLayout title="Gallery" description="Moments in motion — featured posts from Jess DeFranco's Instagram.">
  <Hero title="Gallery" subtitle="On stage & in studio" />

  <section class="section">
    <div class="container">
      <div class="embed-grid">
        {posts.map((url) => (
          <div class="embed-item">
            <InstagramEmbed url={url} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<!-- Loads once for this page only; hydrates the blockquotes above into rich cards. -->
<script async src="https://www.instagram.com/embed.js" is:inline></script>

<style>
  .embed-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-md);
    align-items: start;
    justify-items: center;
  }

  /* Instagram's blockquote ships with wide default margins; tighten so the
     grid stays even before embed.js swaps in the final iframe. */
  .embed-item :global(.instagram-media) {
    margin: 0 auto !important;
    min-width: 0 !important;
  }
</style>
