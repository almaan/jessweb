---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FloralDivider from '../components/FloralDivider.astro';
---

<BaseLayout title="Home">
  <section class="hero-home">
    <div class="hero-home__image">
      <img src="/images/jess-hero.jpg" alt="Jess DeFranco performing — mid-air leap in costume" />
    </div>
    <div class="hero-home__content">
      <h1>Jess DeFranco</h1>
      <p class="hero-home__subtitle">San Francisco dancer & dance educator</p>
      <a href="/about" class="btn">Learn More</a>
    </div>
  </section>

  <section class="section">
    <div class="container intro">
      <FloralDivider />
      <p class="intro__text">
        Jess DeFranco grew up in the Bay Area and is a San Francisco based dancer and dance educator.
        After receiving her Bachelor of Arts in Dance and Asian American Studies from San Francisco
        State University, she began working as a freelance performing artist.
      </p>
      <a href="/about" class="btn">More About Jess</a>
    </div>
  </section>

  <section class="section highlights">
    <div class="container">
      <p class="section-label">Featured</p>
      <h2>Recent Work</h2>
      <div class="highlights__grid">
        <div class="highlight-card">
          <img src="/images/burden_of_proof_poster.jpg" alt="Burden of Proof — KULARTS production poster" class="highlight-card__img" />
          <h3>Burden of Proof</h3>
          <p class="text-light">KULARTS &mdash; 2025</p>
        </div>
        <div class="highlight-card">
          <img src="/images/endure_bw.jpg" alt="Jess DeFranco performing in Endure" class="highlight-card__img" />
          <h3>Endure</h3>
          <p class="text-light">Dance Mission Theater &mdash; 2025</p>
        </div>
        <div class="highlight-card">
          <img src="/images/queering.jpg" alt="Queering Pilipinx Aesthetics — KULARTS production poster" class="highlight-card__img" />
          <h3>Queering Pilipinx Aesthetics</h3>
          <p class="text-light">KULARTS &mdash; 2024</p>
        </div>
      </div>
      <div class="text-center" style="margin-top: var(--space-md);">
        <a href="/work" class="btn">View All Work</a>
      </div>
    </div>
  </section>

  <section class="section collaborators">
    <div class="container text-center">
      <p class="section-label">Collaborators</p>
      <div class="collaborators__list">
        <span>KULARTS</span>
        <span>Garrett + Moulton Productions</span>
        <span>Alyssa Eve Mitchel</span>
        <span>Robert Moses Kin</span>
        <span>Epiphany Dance Theater</span>
        <span>Andrea Salazar</span>
        <span>Kristin Damrow and Company</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-home {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
    padding-top: var(--nav-height);
  }

  .hero-home__image {
    overflow: hidden;
  }

  .hero-home__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-home__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-xl) var(--space-lg);
  }

  .hero-home__subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-light);
    font-weight: 300;
    margin-bottom: var(--space-md);
  }

  @media (max-width: 768px) {
    .hero-home {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-home__image {
      max-height: 60vh;
    }

    .hero-home__content {
      padding: var(--space-lg) var(--space-md);
      text-align: center;
    }
  }

  .intro {
    max-width: 700px;
    text-align: center;
    margin: 0 auto;
  }

  .intro__text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-text-light);
    margin-bottom: var(--space-md);
  }

  .highlights {
    background: var(--color-bg-alt);
  }

  .highlights__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .highlight-card__img {
    aspect-ratio: 3 / 4;
    margin-bottom: var(--space-sm);
    width: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .highlights__grid {
      grid-template-columns: 1fr;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
