---

<BaseLayout title="Work" description="Performances, choreography, and collaborations by Jess DeFranco.">
  <Hero title="Work" subtitle="Selected performances & collaborations" />

  <div class="container">
    <WovenDivider />
  </div>

  <section class="section" style="padding-top: var(--space-md);">
    <div class="container">
      <div class="work-list">
        {performances.map((perf) => (
          <article class="work-item reveal">
            {perf.image
              ? <img src={perf.image} alt={perf.title} class="work-item__img" />
              : <div class="work-item__img work-item__title-card"><span>{perf.title}</span></div>
            }
            <div class="work-item__content">
              <p class="section-label">{perf.year}</p>
              <h3>{perf.title}</h3>
              <p class="work-item__role">{perf.role} {perf.company && <span class="text-light">with {perf.company}</span>}</p>
              <p class="text-light">{perf.venue}</p>
              {perf.description && <p class="work-item__desc">{perf.description}</p>}
              {perf.link && <a href={perf.link} target="_blank" rel="noopener noreferrer" class="work-item__link">Learn more &rarr;</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .work-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .work-item {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-md);
    align-items: start;
  }

  .work-item:nth-child(even) {
    direction: rtl;
  }

  .work-item:nth-child(even) > * {
    direction: ltr;
  }

  .work-item__img {
    aspect-ratio: 4 / 3;
    width: 100%;
    object-fit: cover;
  }

  .work-item__title-card {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    padding: var(--space-md);
    text-align: center;
    overflow: hidden;
  }

  .work-item__title-card span {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    line-height: 1.3;
    word-break: break-word;
  }

  .work-item__role {
    font-weight: 500;
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
  }

  .work-item__desc {
    margin-top: var(--space-sm);
    color: var(--color-text-light);
  }

  .work-item__link {
    display: inline-block;
    margin-top: var(--space-xs);
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 500;
  }

  .work-item__link:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 768px) {
    .work-item {
      grid-template-columns: 1fr;
    }

    .work-item:nth-child(even) {
      direction: ltr;
    }

    .work-item__img {
      max-height: 250px;
    }
  }
</style>
