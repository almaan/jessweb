---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="About" description="Learn about Jess DeFranco — her background, training, and artistic vision.">
  <Hero title="About" />

  <section class="section">
    <div class="container about-grid">
      <div class="about-portrait">
        <img src="/images/main-portrait.jpg" alt="Jess DeFranco" class="about-portrait__img" />
      </div>

      <div class="about-content">
        <p class="section-label">Bio</p>
        <h2>Jess DeFranco</h2>
        <p>
          I grew up in the Bay Area and am a San Francisco based dancer. After receiving
          my Bachelor of Arts in Dance and Asian American Studies from San Francisco State University,
          I began working as a freelance performing artist and dance educator.
        </p>
        <p>
          My first collaboration with KULARTS was in 2022 and 2023 with "Nursing these Wounds",
          followed by the "AntingAnting Project" and presenting my choreography in "Queering Pilipinx
          Aesthetics" in 2024.
        </p>
        <a href="/jess-defranco-resume.pdf" target="_blank" class="btn" style="margin-top: var(--space-sm);">Download Resume</a>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-bg-alt);">
    <div class="container">
      <p class="section-label">Training</p>
      <h2>Background</h2>
      <div class="training-grid">
        <div class="training-item">
          <h3>San Francisco State University</h3>
          <p class="training-item__years">2014–2018</p>
          <p class="text-light">
            Bachelor of Arts in Dance, Minor in Asian American Studies. Member of the University Dance Theater Company.
          </p>
        </div>
        <div class="training-item">
          <h3>Alonzo King LINES Ballet</h3>
          <p class="training-item__years">Summer 2017</p>
          <p class="text-light">
            Summer intensive program at one of the world's premier contemporary ballet companies in San Francisco.
          </p>
        </div>
        <div class="training-item">
          <h3>Pacific Ballet Academy</h3>
          <p class="training-item__years">2012–2014</p>
          <p class="text-light">
            Student and Studio Company Member in Mountain View, CA.
          </p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .about-portrait__img {
    aspect-ratio: 3 / 4;
    width: 100%;
  }

  .training-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .training-item__years {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }

@media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-portrait__img {
      max-width: 350px;
      margin: 0 auto;
    }

    .training-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
