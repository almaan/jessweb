---
// Native Instagram post embed. Renders Instagram's blockquote, which is
// hydrated into a rich card by embed.js (loaded once per page via
// InstagramEmbedScript). Works for any PUBLIC post — no API/token needed.
interface Props {
  url: string;
}

// Normalise to the canonical permalink (strip query strings, ensure trailing slash).
const clean = Astro.props.url.split('?')[0].replace(/\/?$/, '/');
---

<blockquote
  class="instagram-media"
  data-instgrm-permalink={clean}
  data-instgrm-version="14"
>
  <a href={clean}>View this post on Instagram</a>
</blockquote>
