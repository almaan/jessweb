---
interface Props {
  class?: string;
}
---

<div class:list={['floral-divider', Astro.props.class]}>
  <svg viewBox="0 0 200 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <!-- left stem -->
    <path d="M20 16 Q50 16 95 16" stroke="var(--color-mint)" stroke-width="0.8" fill="none" />
    <!-- left leaves -->
    <ellipse cx="42" cy="16" rx="8" ry="4" transform="rotate(-30 42 16)" fill="none" stroke="var(--color-mint)" stroke-width="0.6" />
    <ellipse cx="58" cy="16" rx="7" ry="3.5" transform="rotate(25 58 16)" fill="none" stroke="var(--color-mint)" stroke-width="0.6" />
    <ellipse cx="74" cy="16" rx="6" ry="3" transform="rotate(-20 74 16)" fill="none" stroke="var(--color-mint)" stroke-width="0.6" />
    <!-- center bloom — sampaguita (Philippine national flower): five white star petals with a gold heart -->
    <g class="sampaguita">
      <ellipse cx="100" cy="9.6" rx="2.6" ry="4.4" fill="var(--color-white)" stroke="var(--color-accent)" stroke-width="0.5" />
      <ellipse cx="106.1" cy="14" rx="2.6" ry="4.4" transform="rotate(72 106.1 14)" fill="var(--color-white)" stroke="var(--color-accent)" stroke-width="0.5" />
      <ellipse cx="103.7" cy="21.2" rx="2.6" ry="4.4" transform="rotate(144 103.7 21.2)" fill="var(--color-white)" stroke="var(--color-accent)" stroke-width="0.5" />
      <ellipse cx="96.3" cy="21.2" rx="2.6" ry="4.4" transform="rotate(216 96.3 21.2)" fill="var(--color-white)" stroke="var(--color-accent)" stroke-width="0.5" />
      <ellipse cx="93.9" cy="14" rx="2.6" ry="4.4" transform="rotate(288 93.9 14)" fill="var(--color-white)" stroke="var(--color-accent)" stroke-width="0.5" />
      <circle cx="100" cy="16" r="1.8" fill="var(--color-accent)" />
    </g>
    <!-- right stem -->
    <path d="M105 16 Q150 16 180 16" stroke="var(--color-mint)" stroke-width="0.8" fill="none" />
    <!-- right leaves -->
    <ellipse cx="126" cy="16" rx="6" ry="3" transform="rotate(20 126 16)" fill="none" stroke="var(--color-mint)" stroke-width="0.6" />
    <ellipse cx="142" cy="16" rx="7" ry="3.5" transform="rotate(-25 142 16)" fill="none" stroke="var(--color-mint)" stroke-width="0.6" />
    <ellipse cx="158" cy="16" rx="8" ry="4" transform="rotate(30 158 16)" fill="none" stroke="var(--color-mint)" stroke-width="0.6" />
  </svg>
</div>

<style>
  .floral-divider {
    display: flex;
    justify-content: center;
    padding: var(--space-sm) 0;
  }

  .floral-divider svg {
    width: 180px;
    height: 28px;
    opacity: 0.7;
  }
</style>
