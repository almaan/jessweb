---
interface Props {
  class?: string;
}
---

<div class:list={['floral-divider', Astro.props.class]}>
  <svg viewBox="0 0 200 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <!-- left stem -->
    <path d="M20 16 Q50 16 95 16" stroke="var(--color-mint)" stroke-width="0.8" fill="none" />
    <!-- left leaves -->
    <ellipse cx="42" cy="16" rx="8" ry="4" transform="rotate(-30 42 16)" fill="none" stroke="var(--color-mint)" stroke-width="0.6" />
    <ellipse cx="58" cy="16" rx="7" ry="3.5" transform="rotate(25 58 16)" fill="none" stroke="var(--color-mint)" stroke-width="0.6" />
    <ellipse cx="74" cy="16" rx="6" ry="3" transform="rotate(-20 74 16)" fill="none" stroke="var(--color-mint)" stroke-width="0.6" />
    <!-- center bloom -->
    <circle cx="100" cy="16" r="4" fill="none" stroke="var(--color-accent)" stroke-width="0.8" />
    <circle cx="100" cy="16" r="1.5" fill="var(--color-accent)" opacity="0.4" />
    <!-- petals -->
    <ellipse cx="100" cy="10" rx="2.5" ry="4" fill="none" stroke="var(--color-accent)" stroke-width="0.5" opacity="0.6" />
    <ellipse cx="100" cy="22" rx="2.5" ry="4" fill="none" stroke="var(--color-accent)" stroke-width="0.5" opacity="0.6" />
    <ellipse cx="94" cy="13" rx="2.5" ry="4" transform="rotate(60 94 13)" fill="none" stroke="var(--color-accent)" stroke-width="0.5" opacity="0.6" />
    <ellipse cx="106" cy="13" rx="2.5" ry="4" transform="rotate(-60 106 13)" fill="none" stroke="var(--color-accent)" stroke-width="0.5" opacity="0.6" />
    <ellipse cx="94" cy="19" rx="2.5" ry="4" transform="rotate(-60 94 19)" fill="none" stroke="var(--color-accent)" stroke-width="0.5" opacity="0.6" />
    <ellipse cx="106" cy="19" rx="2.5" ry="4" transform="rotate(60 106 19)" fill="none" stroke="var(--color-accent)" stroke-width="0.5" opacity="0.6" />
    <!-- right stem -->
    <path d="M105 16 Q150 16 180 16" stroke="var(--color-mint)" stroke-width="0.8" fill="none" />
    <!-- right leaves -->
    <ellipse cx="126" cy="16" rx="6" ry="3" transform="rotate(20 126 16)" fill="none" stroke="var(--color-mint)" stroke-width="0.6" />
    <ellipse cx="142" cy="16" rx="7" ry="3.5" transform="rotate(-25 142 16)" fill="none" stroke="var(--color-mint)" stroke-width="0.6" />
    <ellipse cx="158" cy="16" rx="8" ry="4" transform="rotate(30 158 16)" fill="none" stroke="var(--color-mint)" stroke-width="0.6" />
  </svg>
</div>

<style>
  .floral-divider {
    display: flex;
    justify-content: center;
    padding: var(--space-sm) 0;
  }

  .floral-divider svg {
    width: 180px;
    height: 28px;
    opacity: 0.7;
  }
</style>
